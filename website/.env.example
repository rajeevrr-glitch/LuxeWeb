# Copy to .env.local on this computer. Never paste real keys into chat or commit them.
# OFF by default. Enabling a provider uses its account credits and may incur charges.
LUXE_AI_ENABLED=false
# Gemini key stays on the local server. Never use a VITE_ prefix for it.
LUXE_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Optional existing alternatives.
HF_TOKEN=
OPENAI_API_KEY=
# Total pilot attempts across restarts, not a rupee/dollar cap. Failures count too.
LUXE_AI_MAX_ATTEMPTS=2

# Automatic enquiry notifications. Keep off until the account and durable storage are ready.
# These are SERVER variables, never VITE_ variables. No secret belongs in source or chat.
LUXE_ENQUIRY_DELIVERY_ENABLED=false
# Absolute PRIVATE persistent directory outside the public dist/client tree.
LUXE_ENQUIRY_DATA_DIR=
LUXE_WHATSAPP_ACCESS_TOKEN=
# Sender's numeric Phone Number ID from the WhatsApp Business Platform.
LUXE_WHATSAPP_PHONE_NUMBER_ID=
# Internal receiving team number, in international digits (no + or spaces).
LUXE_WHATSAPP_RECIPIENT=
# Approved template with exactly six body variables; see AUTOMATIC-DELIVERY-SETUP.md.
LUXE_WHATSAPP_TEMPLATE=
LUXE_WHATSAPP_LANGUAGE=
# Explicit supported Graph API version, e.g. vXX.Y; confirm in the Meta account docs.
LUXE_WHATSAPP_GRAPH_VERSION=
GEMINI_API_TIER=free

# Optional Luxe text chat. Separate consent, key and allowance from room images.
# Provider access/free-tier eligibility depends on the connected account.
LUXE_CHAT_ENABLED=false
LUXE_CHAT_API_KEY=
LUXE_CHAT_MODEL=gemini-3.5-flash-lite
# Maximum provider attempts per UTC day, including failed attempts (1–100).
LUXE_CHAT_DAILY_LIMIT=20
