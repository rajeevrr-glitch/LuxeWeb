{
  "name": "luxeinfra-website",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "build:review": "vite build --mode review",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint src scripts tests vite.config.ts eslint.config.js --max-warnings 0",
    "format": "prettier --write .",
    "dev:site": "vite dev",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "desk": "node scripts/desk-server.mjs",
    "delivery:check": "node scripts/delivery-readiness.mjs",
    "ai:check": "node scripts/ai-readiness.mjs",
    "start": "node --use-system-ca scripts/production-server.mjs",
    "format:check": "prettier --check src scripts tests vite.config.ts eslint.config.js tsconfig.json package.json"
  },
  "dependencies": {
    "@huggingface/inference": "4.13.32",
    "@radix-ui/react-dialog": "1.1.15",
    "@tailwindcss/vite": "4.2.4",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.42",
    "clsx": "2.1.1",
    "lucide-react": "0.575.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "sharp": "0.35.5",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.4",
    "tw-animate-css": "1.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "15.15.0",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.0",
    "vite": "7.3.7",
    "vite-tsconfig-paths": "6.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
